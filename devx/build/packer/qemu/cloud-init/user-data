#cloud-config
# Creates the user Vagrant expects in a box: "vagrant", with passwordless sudo and
# Vagrant's insecure public keys. Vagrant logs in with the matching private keys,
# which ship with Vagrant, and replaces them with a new key pair on each VM that
# uses the box. Listing users without "default" also leaves out the image's
# default "ubuntu" user.
users:
  - name: vagrant
    gecos: Vagrant
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN1YdxBpNlzxDqfJyw/QKow1F+wvG9hXGoqiysfJOn5Y vagrant insecure public key
      - ssh-rsa  vagrant insecure public key

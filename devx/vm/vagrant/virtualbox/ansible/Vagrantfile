Vagrant.configure("2") do |config|
  # The box isn't on HashiCorp's registry, so box_url points at its
  # catalog.
  config.vm.box = "hako/ubuntu-26.04"
  config.vm.box_url = "https://darkn3rd.github.io/hako/ubuntu-26.04.json"

  config.vm.define "dev"

  config.vm.network "forwarded_port", guest: 80, host: 8080

  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder ".", "/workspace"

  config.vm.provider "virtualbox" do |vb|
    vb.cpus = 2
    vb.memory = 4096
  end

  # Ansible does not run natively on Windows, so run it inside the guest.
  local = Vagrant::Util::Platform.windows?
  provisioner = local ? "ansible_local" : "ansible"

  config.vm.provision provisioner do |ansible|
    ansible.compatibility_mode = "2.0"
    ansible.playbook = "playbook.yaml"
    ansible.groups = { "web" => ["dev"] }
    ansible.provisioning_path = "/workspace" if local
  end
end
